{
  "name": "@open-design/contracts",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Shared pure TypeScript contracts for the Open Design web/daemon boundary.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./shop-home-page": {
      "types": "./src/prompts/shop-home-page.ts",
      "default": "./dist/prompts/shop-home-page.js"
    },
    "./shop-home-page-tones": {
      "types": "./src/prompts/shop-home-page-tones.ts",
      "default": "./dist/prompts/shop-home-page-tones.js"
    },
    "./shop-home-page-image-prompts": {
      "types": "./src/prompts/shop-home-page-image-prompts.ts",
      "default": "./dist/prompts/shop-home-page-image-prompts.js"
    },
    "./shop-home-page-schema": {
      "types": "./src/shop-home-page-schema.ts",
      "default": "./dist/shop-home-page-schema.js"
    },
    "./question-form": {
      "types": "./src/question-form.ts",
      "default": "./dist/question-form.js"
    },
    "./shop-home-page-templates": {
      "types": "./src/shop-home-page-templates.ts",
      "default": "./dist/shop-home-page-templates.js"
    },
    "./shop-home-page-phone-chrome": {
      "types": "./src/shop-home-page-phone-chrome.ts",
      "default": "./dist/shop-home-page-phone-chrome.js"
    },
    "./critique": {
      "types": "./src/critique.ts",
      "default": "./dist/critique.js"
    }
  },
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json --emitDeclarationOnly false && mkdir -p dist/shop-home-page/storefront && cp src/shop-home-page/tone-presets.json dist/shop-home-page/tone-presets.json && cp src/shop-home-page/storefront/tone-presets.json dist/shop-home-page/storefront/tone-presets.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
